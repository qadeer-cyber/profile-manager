 const char SpeechSynthesis::kSupplementName[] = "SpeechSynthesis";
 
+namespace {
+
+// AZWAH: --azwah-speech-voices=<name,name,...> keeps only the installed voices whose name contains one of the entries
+// (case-insensitive), so the list resembles a standard installation instead of this computer's language packs. Voices
+// are never invented, and a list that would become empty is left as it is.
+bool AzwahVoiceAllowed(const String& name,
+                       const std::vector<std::string>& allowed) {
+  for (const std::string& entry : allowed) {
+    if (name.FindIgnoringAsciiCase(String::FromUtf8(std::string_view(entry))) !=
+        String::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
