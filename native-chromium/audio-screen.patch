+void AudioBuffer::AzwahApplyAudioNoise() {
+  if (azwah_audio_noised_) {
+    return;
+  }
+  azwah_audio_noised_ = true;
+  const std::string secret =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "azwah-audio-seed");
+  if (secret.empty()) {
+    return;
+  }
+  uint64_t seed = 1469598103934665603ull;
+  for (const char c : secret) {
+    seed = (seed ^ static_cast<uint8_t>(c)) * 1099511628211ull;
+  }
+  uint64_t channel = 0;
+  for (auto& member : channels_) {
+    ++channel;
+    DOMFloat32Array* array = member.Get();
+    if (!array) {
+      continue;
+    }
+    base::span<float> data = array->AsSpan();
+    for (size_t i = 0; i < data.size(); ++i) {
+      uint64_t hash = seed ^ ((channel << 40) + i);
+      hash ^= hash >> 33;
+      hash *= 0xff51afd7ed558ccdull;
+      hash ^= hash >> 33;
+      if (data[i] != 0.0f) {
+        data[i] += data[i] * ((hash & 1u) ? 1e-7f : -1e-7f);
+      }
+    }
+  }
+}
