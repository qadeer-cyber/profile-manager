+std::optional<net::ProxyConfigWithAnnotation> GetAzwahProxyConfig() {
+#if BUILDFLAG(IS_WIN)
+  const auto env = base::Environment::Create();
+  const auto relay_port = env->GetVar("AZWAH_NATIVE_PROXY_RELAY_PORT");
+  if (relay_port || env->HasVar("AZWAH_NATIVE_PROXY_TIMEZONE")) {
+    unsigned port = 0;
+    // The manager owns this loopback relay. A numeric port prevents extra
+    // proxy entries, bypass rules, direct routes, or secrets in the handoff.
+    CHECK(relay_port && base::StringToUint(*relay_port, &port) &&
+          port > 0 && port <= 65535);
+    net::ProxyConfig proxy_config;
+    proxy_config.proxy_rules().ParseFromString("http://127.0.0.1:" +
+                                               base::NumberToString(port));
+    proxy_config.proxy_rules().bypass_rules.ParseFromString("<-loopback>");
+    auto annotation = net::DefineNetworkTrafficAnnotation(
+        "azwah_profile_proxy", R"(
+          semantics {
+            sender: "Azwah managed profile proxy"
+            description:
+              "Routes Chromium network requests through the proxy assigned to "
+              "the active Azwah profile by the user."
+            trigger: "An Azwah profile with an assigned proxy is running."
+            data: "Proxy route configuration for the profile."
+            destination: LOCAL
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "The user assigns the proxy in Azwah profile settings."
+            policy_exception_justification:
+              "Proxy assignment is managed by the Azwah profile manager."
+          })");
+    return net::ProxyConfigWithAnnotation(proxy_config, annotation);
+  }
+#endif
+  return std::nullopt;
+}
+
+}  // namespace
