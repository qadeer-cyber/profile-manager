+bool UsesProxyLocation() {
+#if BUILDFLAG(IS_WIN)
+  return base::Environment::Create()->HasVar("AZWAH_NATIVE_PROXY_TIMEZONE");
+#else
+  return false;
+#endif
+}
+
+mojom::GeopositionResultPtr ReadProxyLocation() {
+  const auto value = base::Environment::Create()->GetVar(
+      "AZWAH_NATIVE_PROXY_GEOLOCATION");
+  if (value) {
+    const auto fields = base::SplitStringPiece(
+        *value, ",", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+    auto position = mojom::Geoposition::New();
+    if (fields.size() == 3 &&
+        base::StringToDouble(fields[0], &position->latitude) &&
+        base::StringToDouble(fields[1], &position->longitude) &&
+        base::StringToDouble(fields[2], &position->accuracy) &&
+        std::isfinite(position->latitude) && std::isfinite(position->longitude) &&
+        std::isfinite(position->accuracy) && std::abs(position->latitude) <= 90 &&
+        std::abs(position->longitude) <= 180 && position->accuracy > 0) {
+      position->timestamp = base::Time::Now();
+      position->is_precise = false;
+      return mojom::GeopositionResult::NewPosition(std::move(position));
+    }
+  }
+  // A managed profile with missing or invalid data must never query the host.
+  return mojom::GeopositionResult::NewError(mojom::GeopositionError::New(
+      mojom::GeopositionErrorCode::kPositionUnavailable, "", ""));
+}
+
+}  // namespace
+
+GeolocationContext::GeolocationContext() {
+  if (UsesProxyLocation()) {
+    geoposition_override_ = ReadProxyLocation();
+  }
+}
 
