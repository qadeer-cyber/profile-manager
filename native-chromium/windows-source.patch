+    net::IPAddress expected;
+    if (!manager || !expected.AssignFromIPLiteral(*exit_ip)) {
+      return false;
+    }
+    auto factory = manager->GetSharedURLLoaderFactory();
+    auto request = std::make_unique<network::ResourceRequest>();
+    request->url = GURL("https://api64.ipify.org/?format=json");
+    request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    request->redirect_mode = network::mojom::RedirectMode::kError;
