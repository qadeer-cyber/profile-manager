+            sender: "Azwah managed browser startup"
+            description: "Checks the proxy exit IP before opening profile tabs."
+            trigger: "Starting an Azwah profile with an assigned proxy."
+            data: "The source IP of the connection."
+            destination: OTHER
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "Azwah checks the proxy when one is assigned to a profile."
+            policy_exception_justification: "Required for managed profiles."
+          })");
+    auto loader = network::SimpleURLLoader::Create(std::move(request), annotation);
+    loader->SetTimeoutDuration(base::Seconds(10));
+    base::RunLoop loop(base::RunLoop::Type::kNestableTasksAllowed);
+    std::optional<std::string> body;
+    loader->DownloadToString(
+        factory.get(),
+        base::BindOnce(
+            [](base::RunLoop* loop, std::optional<std::string>* result,
+               std::optional<std::string> response) {
+              *result = std::move(response);
+              loop->Quit();
+            },
+            &loop, &body),
+        1024);
+    loop.Run();
+    auto parsed = body ? base::JSONReader::ReadDict(*body, base::JSON_PARSE_RFC)
+                       : std::nullopt;
+    const auto* value = parsed ? parsed->FindString("ip") : nullptr;
+    net::IPAddress observed;
+    if (!value || !observed.AssignFromIPLiteral(*value) || observed != expected) {
+      return false;
+    }
+  }
+  base::RunLoop write_loop(base::RunLoop::Type::kNestableTasksAllowed);
+  bool written = false;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock()},
+      base::BindOnce(
+          [](base::FilePath receipt_path, std::string value) {
+            return base::WriteFile(receipt_path, value);
+          },
+          path, exit_ip.value_or("direct")),
+      base::BindOnce(
+          [](base::RunLoop* loop, bool* result, bool success) {
+            *result = success;
+            loop->Quit();
+          },
