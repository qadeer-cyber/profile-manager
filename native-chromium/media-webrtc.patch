+namespace {
+
+// AZWAH: per-profile media device counts. --azwah-media-devices=<microphones>,<cameras>,<speakers> (each 0 to 4) makes
+// enumerateDevices() report that many devices of each kind, so a profile's counts need not equal this computer's. Extra
+// real devices are hidden. Missing devices are listed with stable per-origin identifiers and no label; they cannot be
+// opened, which is how an unplugged device behaves. A malformed switch leaves the real list untouched.
+String AzwahMediaDeviceId(const std::string& seed,
+                          const String& origin,
+                          int kind,
+                          unsigned index,
+                          const char* purpose) {
+  std::string input = seed + "|" + origin.Utf8() + "|" +
+                      std::to_string(kind) + "|" + std::to_string(index) +
+                      "|" + purpose;
+  DigestValue digest;
+  if (!ComputeDigest(HashAlgorithm::kSha256,
+                     base::as_byte_span(input), digest)) {
+    return String();
+  }
+  static const char kHex[] = "0123456789abcdef";
+  StringBuilder id;
+  for (uint8_t byte : digest) {
+    id.Append(kHex[byte >> 4]);
+    id.Append(kHex[byte & 15]);
+  }
+  return id.ToString();
+}
+
+void AzwahMaskMediaDevices(MediaDeviceInfoVector& devices,
+                           const String& origin) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  const std::vector<std::string> counts = base::SplitString(
+      command_line->GetSwitchValueASCII("azwah-media-devices"), ",",
+      base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (counts.size() != 3) {
+    return;
+  }
+  const std::string seed =
+      command_line->GetSwitchValueASCII("azwah-media-seed");
+  // Chrome lists microphones, then cameras, then speakers.
+  const mojom::blink::MediaDeviceType kinds[3] = {
+      mojom::blink::MediaDeviceType::kMediaAudioInput,
+      mojom::blink::MediaDeviceType::kMediaVideoInput,
+      mojom::blink::MediaDeviceType::kMediaAudioOutput};
+  const char* const labels[3] = {"Microphone", "Camera", "Speakers"};
+  unsigned wanted[3];
+  for (int k = 0; k < 3; ++k) {
+    if (!base::StringToUint(counts[k], &wanted[k]) || wanted[k] > 4) {
+      return;
+    }
+  }
+  MediaDeviceInfoVector masked;
+  for (int k = 0; k < 3; ++k) {
+    unsigned have = 0;
+    bool has_labels = false;
+    for (const auto& device : devices) {
+      if (device->DeviceType() != kinds[k]) {
+        continue;
+      }
+      has_labels = has_labels || !device->label().empty();
+      if (have < wanted[k]) {
+        masked.push_back(device);
+      }
+      ++have;
+    }
+    for (unsigned i = have; i < wanted[k]; ++i) {
+      const String id = AzwahMediaDeviceId(seed, origin, k, i, "id");
+      const String group = AzwahMediaDeviceId(seed, origin, k, i, "group");
+      const String label = has_labels ? String(labels[k]) : String();
+      if (kinds[k] == mojom::blink::MediaDeviceType::kMediaAudioOutput) {
+        masked.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+            id, label, group, kinds[k]));
+      } else {
+        masked.push_back(MakeGarbageCollected<InputDeviceInfo>(
+            id, label, group, kinds[k]));
+      }
+    }
+  }
+  devices = std::move(masked);
+}
