+// AZWAH: public address shown in this profile's server-reflexive ICE candidates. --azwah-webrtc-public-ip is the
+// verified exit address of the profile's proxy (IPv4 or IPv6), set by AZWAH only after it observed that exit. Without
+// the switch candidates are untouched. Only "typ srflx" candidates are rewritten, and only when the address family
+// matches: the connection address becomes the proxy exit and the related address becomes unspecified, so a page sees the
+// same public address as every other request of the profile. Host and relay candidates are not altered. This changes
+// what script and the SDP report, not which addresses the network stack uses; AZWAH keeps non-proxied UDP disabled.
+std::string AzwahMaskCandidateLine(const std::string& line,
+                                   const std::string& public_ip) {
+  if (line.find(" typ srflx") == std::string::npos ||
+      (line.rfind("a=candidate:", 0) != 0 &&
+       line.rfind("candidate:", 0) != 0)) {
+    return line;
+  }
+  std::vector<std::string> tokens = base::SplitString(
+      line, " ", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (tokens.size() < 8) {
+    return line;
+  }
+  const bool public_is_v6 = public_ip.find(':') != std::string::npos;
+  if ((tokens[4].find(':') != std::string::npos) != public_is_v6) {
+    return line;
+  }
+  tokens[4] = public_ip;
+  for (size_t i = 8; i + 1 < tokens.size(); ++i) {
+    if (tokens[i] != "raddr") {
+      continue;
+    }
+    tokens[i + 1] = public_is_v6 ? "::" : "0.0.0.0";
+    if (i + 3 < tokens.size() && tokens[i + 2] == "rport") {
+      tokens[i + 3] = "0";
+    }
+  }
+  std::string masked;
+  for (size_t i = 0; i < tokens.size(); ++i) {
+    if (i) {
+      masked += ' ';
+    }
+    masked += tokens[i];
+  }
+  return masked;
+}
+
+std::string AzwahMaskLocalSdp(const std::string& sdp) {
+  const std::string public_ip =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "azwah-webrtc-public-ip");
+  if (public_ip.empty() || sdp.find(" typ srflx") == std::string::npos) {
+    return sdp;
+  }
+  std::string result;
+  size_t start = 0;
+  while (start <= sdp.size()) {
+    size_t end = sdp.find('\n', start);
+    const bool last = end == std::string::npos;
+    std::string line = sdp.substr(start, last ? std::string::npos : end - start);
+    const bool has_cr = !line.empty() && line.back() == '\r';
+    if (has_cr) {
+      line.pop_back();
+    }
+    result += AzwahMaskCandidateLine(line, public_ip);
+    if (has_cr) {
+      result += '\r';
+    }
+    if (last) {
+      break;
+    }
+    result += '\n';
+    start = end + 1;
+  }
+  return result;
+}
