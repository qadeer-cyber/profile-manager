+// AZWAH: local descriptions (offers, answers and the local side of the current state) pass through the candidate mask.
+RTCSessionDescriptionPlatform* CreateLocalWebKitSessionDescription(
+    const webrtc::SessionDescriptionInterface* native_desc) {
+  if (!native_desc) {
+    LOG(ERROR) << "Native session description is null.";
+    return nullptr;
+  }
+  std::string sdp;
+  if (!native_desc->ToString(&sdp)) {
+    LOG(ERROR) << "Failed to get SDP string of native session description.";
+    return nullptr;
+  }
+  return CreateWebKitSessionDescription(AzwahMaskLocalSdp(sdp),
+                                        native_desc->type());
+}
