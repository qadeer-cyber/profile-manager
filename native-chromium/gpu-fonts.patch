+namespace {
+
+// AZWAH: per-profile installed-font list from --azwah-font-allowlist (comma
+// separated, lower case). Fonts outside the list behave as not installed.
+// Read once per process; std::string so it is safe on every font thread.
+const std::set<std::string>* AzwahFontAllowlist() {
+  static const base::NoDestructor<std::optional<std::set<std::string>>> list(
+      []() -> std::optional<std::set<std::string>> {
+        const std::string value =
+            base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+                "azwah-font-allowlist");
+        if (value.empty()) {
+          return std::nullopt;
+        }
+        std::set<std::string> families;
+        for (const std::string& family :
+             base::SplitString(value, ",", base::TRIM_WHITESPACE,
+                               base::SPLIT_WANT_NONEMPTY)) {
+          families.insert(family);
+        }
+        return families;
+      }());
+  return list->has_value() ? &list->value() : nullptr;
+}
