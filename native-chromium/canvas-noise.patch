+namespace {
+
+uint64_t AzwahMix(uint64_t value) {
+  value += 0x9e3779b97f4a7c15ull;
+  value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ull;
+  value = (value ^ (value >> 27)) * 0x94d049bb133111ebull;
+  return value ^ (value >> 31);
+}
+
+}  // namespace
+
+// static
+uint64_t HTMLCanvasElement::AzwahCanvasNoiseSeed(
+    const ExecutionContext* context) {
+  const std::string secret =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "azwah-canvas-seed");
+  if (secret.empty() || !context) {
+    return 0;
+  }
+  String site;
+  if (const auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    site = window->GetStorageKey().GetTopLevelSite().Serialize();
+  } else if (const SecurityOrigin* origin = context->GetSecurityOrigin()) {
+    site = origin->RegistrableDomain();
+    if (site.IsNull() || !site.length()) {
+      site = origin->ToString();
+    }
+  }
+  const std::string material = secret + "\n" + site.Utf8();
+  const base::SHA1Digest digest = base::SHA1Hash(base::as_byte_span(material));
+  uint64_t seed = 0;
+  for (size_t i = 0; i < 8; ++i) {
+    seed = (seed << 8) | digest[i];
+  }
+  return seed | 1;
+}
+
+// static
+void HTMLCanvasElement::AzwahApplyCanvasNoise(const SkPixmap& pixmap,
+                                              uint64_t seed,
+                                              int origin_x,
+                                              int origin_y) {
+  const SkColorType type = pixmap.colorType();
+  if (!seed || !pixmap.writable_addr() ||
+      (type != kRGBA_8888_SkColorType && type != kBGRA_8888_SkColorType)) {
+    return;
+  }
+  const bool premultiplied = pixmap.alphaType() == kPremul_SkAlphaType;
+  const size_t row_bytes = pixmap.rowBytes();
+  // SAFETY: writable_addr() points to computeByteSize() bytes owned by the
+  // pixmap's buffer for its whole lifetime.
+  base::span<uint8_t> bytes = UNSAFE_BUFFERS(
+      base::span(static_cast<uint8_t*>(pixmap.writable_addr()),
+                 pixmap.computeByteSize()));
+  for (int y = 0; y < pixmap.height(); ++y) {
+    for (int x = 0; x < pixmap.width(); ++x) {
+      const size_t offset = static_cast<size_t>(y) * row_bytes +
+                            static_cast<size_t>(x) * 4u;
+      if (bytes[offset + 3] == 0) {
+        continue;
+      }
+      const uint64_t position =
+          (static_cast<uint64_t>(static_cast<uint32_t>(origin_x + x)) << 32) |
+          static_cast<uint32_t>(origin_y + y);
+      const uint64_t hash = AzwahMix(seed ^ AzwahMix(position));
+      if ((hash & 31u) != 0) {
+        continue;
+      }
+      const size_t channel = offset + static_cast<size_t>((hash >> 8) % 3u);
+      const uint8_t changed = bytes[channel] ^ 1u;
+      if (!premultiplied || changed <= bytes[offset + 3]) {
+        bytes[channel] = changed;
+      }
+    }
+  }
+}
+
+// static
+scoped_refptr<StaticBitmapImage> HTMLCanvasElement::AzwahApplyCanvasNoise(
+    scoped_refptr<StaticBitmapImage> image,
+    uint64_t seed) {
+  if (!seed || !image) {
+    return image;
+  }
+  auto paint_image = image->PaintImageForCurrentFrame();
+  const gfx::Size size = image->Size();
+  const SkImageInfo info =
+      SkImageInfo::Make(size.width(), size.height(), kN32_SkColorType,
+                        kPremul_SkAlphaType,
+                        paint_image.GetSkImageInfo().refColorSpace());
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info) ||
+      !paint_image.readPixels(info, bitmap.getPixels(), bitmap.rowBytes(), 0,
+                              0)) {
+    return image;
+  }
+  AzwahApplyCanvasNoise(bitmap.pixmap(), seed, 0, 0);
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromBitmap(bitmap));
+}
+
 }  // namespace blink
