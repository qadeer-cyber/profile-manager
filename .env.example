# The app does not load this file. Export a variable only when you need to override a default.
# Leave values empty. Do not put real tokens, proxy passwords, or key material here.

# Web mode (npm start / npm run dev:api)
HOST=
PORT=
PM_DATA_DIR=
PM_API_TOKEN=
PM_SECRET=
HEADLESS=
PROXY_TEST_URL=
PM_PROXY_TEST_TIMEOUT_MS=
PM_HEALTH_INTERVAL=
PM_SHUTDOWN_TIMEOUT_MS=

# Desktop only. Unset for a normal install. Data then lives under the OS
# app-data directory for the package name "profile-manager".
PM_USER_DATA=
